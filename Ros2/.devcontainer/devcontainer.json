{
  "name": "ROS 2 Dev",
  "build": { "dockerfile": "../Dockerfile", "context": ".." },
  "workspaceFolder": "/workspace",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind",
  "runArgs": ["--ipc=host", "--network=host"],
  "postStartCommand": "sh /workspace/.devcontainer/post_start.sh",
  
  // Browser-based desktop for GUI apps (turtlesim, rviz)
  "features": {
    "ghcr.io/devcontainers/features/desktop-lite:1": {}
  },
  "forwardPorts": [6080],
  // Open the desktop in the browser automatically (password: vscode)
  "portsAttributes": {
    "6080": { "label": "ROS Desktop (password: vscode)", "onAutoForward": "openBrowser" }
  },
  "containerEnv": {
    "DISPLAY": ":1",
    "ROS_DOMAIN_ID": "0",
    "ROS_AUTOMATIC_DISCOVERY_RANGE": "SUBNET",
    "RMW_IMPLEMENTATION": "rmw_fastrtps_cpp"
  },

  "customizations": {
    "vscode": { "extensions": ["ms-vscode.cpptools", "ms-python.python"] }
  }
}
